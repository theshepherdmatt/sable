*~
.DS_Store

# SimDisplay frame output
var/

# Live, machine-specific runtime config -- NOT committed.
# Sane defaults live in config/settings.default.json; the app falls back to
# its in-code DEFAULTS (which that file mirrors) when this is absent.
config/settings.json

# Backups of the retired quadify unit files -- not Sable's own code
disabled-units/

# Per-machine hardware pin overrides (wiring); see config/hardware.example.json
config/hardware.json
