    {
      "id": "actions",
      "label": "Actions",
      "element": "section",
      "icon": "fa-cogs",
      "content": [
        {
          "element": "button",
          "label": "Reload settings",
          "description": "Re-sync the panel if it looks out of date (no restart).",
          "onClick": {
            "type": "emit",
            "message": "callMethod",
            "data": {
              "endpoint": "system_hardware/sable",
              "method": "reloadSable",
              "data": ""
            }
          }
        },
        {
          "element": "button",
          "label": "Restart Sable",
          "description": "Full restart; needed after changes like screen rotation.",
          "onClick": {
            "type": "emit",
            "message": "callMethod",
            "data": {
              "endpoint": "system_hardware/sable",
              "method": "restartSable",
              "data": ""
            }
