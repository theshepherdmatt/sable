{
  "page": {
    "label": "Sable",
    "icon": "fa-sliders"
  },
  "sections": [
    {
      "id": "display",
      "label": "Display",
      "element": "section",
      "icon": "fa-television",
      "onSave": {
        "type": "controller",
        "endpoint": "system_hardware/sable",
        "method": "saveDisplay"
      },
      "content": [
        {
          "id": "display_screen",
          "element": "select",
          "label": "Now-playing screen",
          "value": {
            "value": "modern",
            "label": "Modern (album art)"
          },
          "options": [
            {
              "value": "modern",
              "label": "Modern (album art)"
            },
            {
              "value": "spectrum",
              "label": "Spectrum visualiser"
            }
          ]
        },
        {
          "id": "theme",
          "element": "select",
          "label": "Modern theme",
          "description": "Used when the now-playing screen is Modern.",
          "value": {
            "value": "panel",
            "label": "Panel (art + info)"
          },
          "options": [
            {
              "value": "panel",
              "label": "Panel (art + info)"
            },
            {
              "value": "cinema",
              "label": "Cinema (full-bleed art)"
            }
          ]
        },
        {
          "id": "spectrum_style",
          "element": "select",
          "label": "Spectrum style",
          "description": "Used when the now-playing screen is set to Spectrum.",
          "value": {
            "value": "bars",
            "label": "Bars"
          },
          "options": [
            {
              "value": "bars",
              "label": "Bars"
            },
            {
              "value": "dots",
              "label": "Dots"
            },
            {
              "value": "mirror",
              "label": "Mirror"
            },
            {
              "value": "ribbon",
              "label": "Ribbon"
            },
            {
              "value": "vu",
              "label": "VU meter (analog needles)"
            }
          ]
        },
        {
          "id": "brightness",
          "element": "select",
          "label": "Brightness",
          "value": {
            "value": "high",
            "label": "High"
          },
          "options": [
            {
              "value": "low",
              "label": "Low"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "high",
              "label": "High"
            }
          ]
        },
        {
          "id": "transitions",
          "element": "switch",
          "label": "Crossfade between screens",
          "value": true
        },
        {
          "id": "display_rotate",
          "element": "select",
          "label": "Screen rotation",
          "description": "Set to 180 degrees if the panel is mounted upside-down. Changing this restarts Sable.",
          "value": {
            "value": 0,
            "label": "Normal (0 degrees)"
          },
          "options": [
            {
              "value": 0,
              "label": "Normal (0 degrees)"
            },
            {
              "value": 180,
              "label": "Upside-down (180 degrees)"
            }
          ]
        }
      ],
      "saveButton": {
        "label": "Save",
        "data": [
          "display_screen",
          "theme",
          "spectrum_style",
          "brightness",
          "transitions",
          "display_rotate"
        ]
      }
    },
    {
      "id": "clock",
      "label": "Clock",
      "element": "section",
      "icon": "fa-clock-o",
      "onSave": {
        "type": "controller",
        "endpoint": "system_hardware/sable",
        "method": "saveClock"
      },
      "content": [
        {
          "id": "show_seconds",
          "element": "switch",
          "label": "Show seconds",
          "value": false
        },
        {
          "id": "show_date",
          "element": "switch",
          "label": "Show date",
          "value": false
        }
      ],
      "saveButton": {
        "label": "Save",
        "data": [
          "show_seconds",
          "show_date"
        ]
      }
    },
    {
      "id": "screensaver",
      "label": "Screensaver",
      "element": "section",
      "icon": "fa-moon-o",
      "onSave": {
        "type": "controller",
        "endpoint": "system_hardware/sable",
        "method": "saveScreensaver"
      },
      "content": [
        {
          "id": "clock_after_s",
          "element": "input",
          "type": "number",
          "label": "Show clock after (seconds)",
          "value": 300,
          "attributes": [
            {
              "property": "min",
              "value": 0
            }
          ],
          "description": "These apply in order while idle: show clock -> dim -> switch off. Time before a paused/idle now-playing screen falls to the clock (300 = 5 minutes). 0 = never."
        },
        {
          "id": "dim_s",
          "element": "input",
          "type": "number",
          "label": "Dim after (seconds)",
          "value": 120,
          "attributes": [
            {
              "property": "min",
              "value": 0
            }
          ],
          "description": "Idle time before the panel dims and starts shifting (burn-in protection) (120 = 2 minutes). 0 disables."
        },
        {
          "id": "idle_s",
          "element": "input",
          "type": "number",
          "label": "Switch off after (seconds)",
          "value": 3600,
          "attributes": [
            {
              "property": "min",
              "value": 0
            }
          ],
          "description": "Idle time before the panel fades to black (3600 = 1 hour). 0 = never."
        }
      ],
      "saveButton": {
        "label": "Save",
        "data": [
          "clock_after_s",
          "dim_s",
          "idle_s"
        ]
      }
    },
    {
      "id": "controls",
      "label": "Controls",
      "element": "section",
      "icon": "fa-gamepad",
      "onSave": {
        "type": "controller",
        "endpoint": "system_hardware/sable",
        "method": "saveControls"
      },
      "content": [
        {
          "id": "leds_enabled",
          "element": "switch",
          "label": "Buttons and LEDs",
          "value": true
        },
        {
          "id": "ir_enabled",
          "element": "switch",
          "label": "IR remote",
          "value": true
        }
      ],
      "saveButton": {
        "label": "Save",
        "data": [
          "leds_enabled",
          "ir_enabled"
        ]
      }
    },
    {
      "id": "ir_remote",
      "label": "IR Remote Profile",
      "element": "section",
      "icon": "fa-rss",
      "onSave": {
        "type": "controller",
        "endpoint": "system_hardware/sable",
        "method": "saveIrProfile"
      },
      "content": [
        {
          "id": "ir_profile",
          "element": "select",
          "label": "Remote profile",
          "description": "Pick the LIRC profile that matches your IR remote. Saving copies it to /etc/lirc and restarts lircd. Default: Xiaomi IR for TV box. Options are read from the bundled profile library.",
          "value": {
            "value": "Xiaomi IR for TV box",
            "label": "Xiaomi IR for TV box"
          },
          "options": []
        },
        {
          "id": "ir_gpio_pin",
          "element": "input",
          "type": "number",
          "label": "IR receiver GPIO pin (BCM)",
          "attributes": [
            {
              "property": "min",
              "value": 0
            },
            {
              "property": "max",
              "value": 27
            }
          ],
          "value": 4,
          "description": "BCM pin the IR receiver is wired to (default 4, the standard Quadify wiring). Saving rewrites the gpio-ir line in /boot/userconfig.txt -- requires a reboot to take effect."
        }
      ],
      "saveButton": {
        "label": "Save",
        "data": [
          "ir_profile",
          "ir_gpio_pin"
        ]
      }
    },
